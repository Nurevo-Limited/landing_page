---
/**
 * Line icons in the logo's rounded-stroke style, used for audience cards,
 * system card tiles and data protection principles. Decorative: each
 * icon sits beside a heading that says the same thing in text. Strokes
 * draw in once as the icon scrolls into view.
 */
interface Props {
  kind: string;
  dark?: boolean;
  class?: string;
}

const { kind, dark = false, class: className } = Astro.props;
const stroke = dark ? "url(#nv-icon-dark)" : "url(#nv-icon)";

const paths: Record<string, string[]> = {
  // Audiences
  health: ["M8 40V18l16-9 16 9v22", "M4 40h40", "M20 40v-9h8v9", "M24 15v8M20 19h8"],
  primary: ["M14 7v10a8 8 0 0 0 16 0V7", "M22 25v5a8 8 0 0 0 16 0v-3", "M38 27a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"],
  care: ["M7 22L24 9l17 13", "M11 19v21h26V19", "M24 35c-6-4-8-7-8-9.5a3.6 3.6 0 0 1 8-1.4 3.6 3.6 0 0 1 8 1.4c0 2.5-2 5.5-8 9.5z"],
  research: ["M19 7h10", "M21 7v11L11 36a3 3 0 0 0 2.6 4.5h20.8A3 3 0 0 0 37 36L27 18V7", "M15 30h18"],
  investors: ["M7 40h34", "M10 34l9-9 7 6 13-15", "M31 16h8v8"],
  // Data protection
  consent: ["M24 42a18 18 0 1 0 0-36 18 18 0 0 0 0 36z", "M16 24.5l5.5 5.5L33 18.5"],
  gdpr: ["M24 6l15 6v11c0 9.5-6.4 16.4-15 19-8.6-2.6-15-9.5-15-19V12z", "M18 23h12v9H18z", "M20.5 23v-3a3.5 3.5 0 0 1 7 0v3"],
  minimise: ["M7 10h34L28 26v12l-8 4V26z"],
  // Roadmap
  today: ["M24 42a18 18 0 1 0 0-36 18 18 0 0 0 0 36z", "M24 14v10l7 5"],
  feasibility: ["M19 7h10", "M21 7v11L11 36a3 3 0 0 0 2.6 4.5h20.8A3 3 0 0 0 37 36L27 18V7", "M15 30h18"],
  model: ["M24 6l18 9-18 9-18-9z", "M6 24l18 9 18-9", "M6 33l18 9 18-9"],
  studies: ["M14 10h20a3 3 0 0 1 3 3v26a3 3 0 0 1-3 3H14a3 3 0 0 1-3-3V13a3 3 0 0 1 3-3z", "M19 7h10v6H19z", "M17 26l4.5 4.5L31 21"],
  pathway: ["M24 6l15 6v11c0 9.5-6.4 16.4-15 19-8.6-2.6-15-9.5-15-19V12z", "M17 24l5 5 9-10"],
  // System card
  "intended-use": ["M24 42a18 18 0 1 0 0-36 18 18 0 0 0 0 36z", "M24 33a9 9 0 1 0 0-18 9 9 0 0 0 0 18z", "M24 25.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"],
  population: ["M16 20a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", "M32 20a5 5 0 1 0 0-10 5 5 0 0 0 0 10z", "M6 38c1-7 5.5-11 10-11s9 4 10 11", "M22 38c1-7 5.5-11 10-11s9 4 10 11"],
  inputs: ["M6 12c3-5 5-5 8 0s5 5 8 0", "M6 20h6m4 0h10", "M6 28c4-3 8 3 12 0", "M6 36h14", "M28 24h14", "M36 18l6 6-6 6"],
  output: ["M8 40h32", "M12 34V24", "M20 34V14", "M28 34V20", "M36 34V10"],
  limitations: ["M24 42a18 18 0 1 0 0-36 18 18 0 0 0 0 36z", "M24 22v12", "M24 15.5v.5"],
  oversight: ["M17 20a6 6 0 1 0 0-12 6 6 0 0 0 0 12z", "M6 38c1.5-8 6-12 11-12s9.5 4 11 12", "M28 24l5 5 9-10"],
  fairness: ["M24 8v32", "M14 40h20", "M9 15h30", "M9 15l-5 10a5 5 0 0 0 10 0z", "M39 15l-5 10a5 5 0 0 0 10 0z"],
};
const list = paths[kind] ?? paths["intended-use"];
---

<svg
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 48 48"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["h-11 w-11", className]}
>
  {list.map((d) => <path class="reveal-draw" pathLength="1" d={d} stroke={stroke} stroke-width="2" />)}
</svg>
