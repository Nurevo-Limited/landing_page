---
/**
 * Shared gradients for every inline SVG on the page. Kept in a zero-size
 * SVG rather than display:none, because some browsers ignore gradients
 * defined inside a hidden SVG.
 */
---

<svg aria-hidden="true" focusable="false" width="0" height="0" class="absolute h-0 w-0 overflow-hidden">
  <defs>
    <linearGradient id="nv-grad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7398FF"></stop>
      <stop offset="1" stop-color="#A9EDFF"></stop>
    </linearGradient>
    <linearGradient id="nv-grad-v" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#A9EDFF"></stop>
      <stop offset="1" stop-color="#7398FF"></stop>
    </linearGradient>
    <linearGradient id="nv-grad-deep" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2F5BD8"></stop>
      <stop offset="1" stop-color="#7398FF"></stop>
    </linearGradient>
    <!-- Fixed-coordinate gradients: safe on straight lines. -->
    <linearGradient id="nv-icon" gradientUnits="userSpaceOnUse" x1="4" y1="6" x2="44" y2="42">
      <stop offset="0" stop-color="#2F5BD8"></stop>
      <stop offset="1" stop-color="#7398FF"></stop>
    </linearGradient>
    <linearGradient id="nv-icon-dark" gradientUnits="userSpaceOnUse" x1="4" y1="6" x2="44" y2="42">
      <stop offset="0" stop-color="#7398FF"></stop>
      <stop offset="1" stop-color="#A9EDFF"></stop>
    </linearGradient>
    <linearGradient id="nv-hero" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="480" y2="0">
      <stop offset="0" stop-color="#7398FF"></stop>
      <stop offset="1" stop-color="#A9EDFF"></stop>
    </linearGradient>
    <radialGradient id="nv-node" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#A9EDFF" stop-opacity="0.9"></stop>
      <stop offset="0.45" stop-color="#7398FF" stop-opacity="0.35"></stop>
      <stop offset="1" stop-color="#7398FF" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
</svg>
