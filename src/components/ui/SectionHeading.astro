---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  dark?: boolean;
  level?: "h1" | "h2";
  size?: "xl" | "lg" | "md";
  class?: string;
}

const {
  id,
  title,
  eyebrow,
  intro,
  dark = false,
  level = "h2",
  size = "lg",
  class: className,
} = Astro.props;
const Tag = level;
const sizeClass = {
  xl: "text-5xl leading-[1.05] sm:text-6xl lg:text-7xl",
  lg: "text-4xl leading-[1.1] sm:text-5xl",
  md: "text-3xl leading-tight sm:text-4xl",
}[size];
---

<div class:list={["max-w-3xl", className]}>
  {eyebrow && <Eyebrow dark={dark}>{eyebrow}</Eyebrow>}
  <Tag id={id} class:list={["font-display", sizeClass, dark ? "text-white" : "text-ink", eyebrow && "mt-5"]}>
    {title}
  </Tag>
  {intro && <p class:list={["mt-6 text-lg leading-8", dark ? "text-slate-300" : "text-body"]}>{intro}</p>}
  <slot />
</div>
