---
/**
 * Page band with a consistent spacing scale. `dark` and `deep` are navy
 * tones; they add the `tone-dark` class so links, buttons and focus rings
 * switch to their light variants.
 */
interface Props {
  tone?: "light" | "mist" | "dark" | "deep";
  pad?: "lg" | "md" | "sm" | "none";
  width?: "prose" | "default";
  id?: string;
  labelledby?: string;
  class?: string;
  inner?: string;
}

const {
  tone = "light",
  pad = "lg",
  width = "default",
  id,
  labelledby,
  class: className,
  inner,
} = Astro.props;

const toneClass = {
  light: "bg-white",
  mist: "bg-mist",
  dark: "tone-dark bg-ink text-slate-300",
  deep: "tone-dark bg-ink-2 text-slate-300",
}[tone];

const padClass = {
  lg: "py-24 sm:py-32",
  md: "py-16 sm:py-24",
  sm: "py-10 sm:py-14",
  none: "",
}[pad];
---

<section
  id={id}
  aria-labelledby={labelledby}
  class:list={["relative scroll-mt-24 overflow-clip", toneClass, className]}
>
  <slot name="bg" />
  <div class:list={["relative mx-auto w-full px-6", width === "prose" ? "max-w-3xl" : "max-w-6xl", padClass, inner]}>
    <slot />
  </div>
</section>
