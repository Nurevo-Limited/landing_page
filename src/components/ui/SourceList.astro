---
import { site } from "../../content/site";

interface Source {
  n: number;
  name: string;
  url: string;
  note: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<div class="border-t border-line pt-6">
  <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{site.ui.source}</p>
  <ol class="mt-3 space-y-2 text-sm leading-6">
    {
      sources.map((source) => (
        <li id={`source-${source.n}`} class="flex gap-3 scroll-mt-28">
          <span class="w-5 shrink-0 font-medium text-ink">{source.n}</span>
          <span>
            <a href={source.url} target="_blank" rel="noopener noreferrer">{source.name}</a>. {source.note}
          </span>
        </li>
      ))
    }
  </ol>
</div>
