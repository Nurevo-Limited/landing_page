---
import Breadcrumb from "../Breadcrumb.astro";
import Eyebrow from "./Eyebrow.astro";
import HeroVisual from "../HeroVisual.astro";
import type { PageMeta } from "../../content/site";

type VisualKind = "technology" | "solutions" | "about" | "faq" | "company" | "contact" | "news";

interface Props {
  page: PageMeta;
  eyebrow?: string;
  intro?: string;
  tone?: "dark" | "light";
  width?: "prose" | "default";
  visual?: VisualKind;
}

const { page, eyebrow, intro, tone = "dark", width = "default", visual } = Astro.props;
const dark = tone === "dark";
---

<section
  class:list={["relative overflow-clip", dark ? "tone-dark bg-ink text-slate-300" : "border-b border-line bg-white"]}
  aria-labelledby="page-title"
>
  {
    dark && !visual && (
      <>
        <div class="dot-grid absolute inset-0 opacity-60" aria-hidden="true" />
        <div class="glow -right-32 -top-40 h-[30rem] w-[30rem] opacity-70" aria-hidden="true" />
      </>
    )
  }
  <div class:list={["relative mx-auto w-full px-6 pt-10 pb-16 sm:pb-24", width === "prose" ? "max-w-3xl" : "max-w-6xl"]}>
    <Breadcrumb crumbs={page.crumbs} dark={dark} />
    <div class:list={["mt-14 sm:mt-20", visual ? "grid items-center gap-12 lg:grid-cols-12" : "max-w-3xl"]}>
      <div class={visual ? "lg:col-span-7" : undefined}>
        {eyebrow && <Eyebrow dark={dark}>{eyebrow}</Eyebrow>}
        <h1
          id="page-title"
          class:list={[
            "font-display text-5xl leading-[1.06] sm:text-6xl",
            dark ? "text-white" : "text-ink",
            eyebrow && "mt-5",
          ]}
        >
          {page.h1}
        </h1>
        {intro && <p class:list={["mt-8 max-w-2xl text-lg leading-8", dark ? "text-slate-300" : "text-body"]}>{intro}</p>}
        <slot />
      </div>
      {
        visual && (
          <div class="lg:col-span-5">
            <HeroVisual kind={visual} />
          </div>
        )
      }
    </div>
  </div>
</section>
