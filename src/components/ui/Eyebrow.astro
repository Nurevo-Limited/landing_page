---
interface Props {
  dark?: boolean;
  class?: string;
}

const { dark = false, class: className } = Astro.props;
---

<p
  class:list={[
    "inline-flex items-center gap-2.5 text-xs font-medium uppercase tracking-[0.16em]",
    dark ? "text-accent-2" : "text-link",
    className,
  ]}
>
  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-accent"></span>
  <slot />
</p>
