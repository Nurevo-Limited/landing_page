---
/**
 * Hidden until public/copy.js runs, so readers without JavaScript never
 * see a button that does nothing. The text itself is always selectable.
 */
import { site } from "../content/site";

interface Props {
  target: string;
  dark?: boolean;
}

const { target, dark = false } = Astro.props;
---

<button
  type="button"
  hidden
  data-copy={target}
  data-copied={site.ui.copied}
  class:list={[
    "inline-flex min-h-8 items-center gap-1.5 rounded-full border px-3 text-xs font-medium transition-colors",
    dark ? "border-white/20 text-white hover:border-white/60" : "border-line text-ink hover:border-ink",
  ]}
>
  <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
    <rect x="5" y="5" width="9" height="9" rx="2"></rect>
    <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"></path>
  </svg>
  <span>{site.ui.copy}</span>
</button>
