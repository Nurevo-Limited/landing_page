---
import { Image } from "astro:assets";
import wordmark from "../assets/brand/nurevo-wordmark-gradient.png";
import { site } from "../content/site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const items = site.pages.filter((page) => page.nav && page.path !== "/contact");
const isCurrent = (path: string) =>
  path === currentPath || (path !== "/" && currentPath.startsWith(`${path}/`));
---

<header class="site-header sticky top-0 z-40 border-b border-white/[0.07] text-white">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-6 py-3.5">
    <a href="/" class="shrink-0 rounded-sm">
      <Image
        src={wordmark}
        alt="Nurevo home"
        width={155}
        height={28}
        densities={[1, 2]}
        format="webp"
        class="h-7 w-auto"
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {
        items.map((item) => (
          <a
            href={item.path}
            aria-current={isCurrent(item.path) ? "page" : undefined}
            class:list={[
              "text-[0.875rem] transition-colors duration-200 hover:text-white",
              isCurrent(item.path) ? "text-white" : "text-white/60",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:block">
      <a class="btn btn-primary min-h-9 px-4 text-sm" href="/contact" aria-current={currentPath === "/contact" ? "page" : undefined}>
        {site.ui.talkToUs}
      </a>
    </div>

    <details class="lg:hidden">
      <summary class="flex items-center gap-2 rounded-full border border-white/15 px-3.5 py-1.5 text-sm font-medium text-white">
        <svg aria-hidden="true" viewBox="0 0 16 16" class="menu-open h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M2 5h12M2 11h12"></path>
        </svg>
        <svg aria-hidden="true" viewBox="0 0 16 16" class="menu-close h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M4 4l8 8M12 4l-8 8"></path>
        </svg>
        {site.ui.menu}
      </summary>
      <nav
        class="mobile-sheet absolute inset-x-0 top-full z-50 border-b border-white/10 bg-ink px-6 pt-2 pb-6"
        aria-label="Primary"
      >
        <ul class="divide-y divide-white/[0.07]">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.path}
                  aria-current={isCurrent(item.path) ? "page" : undefined}
                  class:list={[
                    "flex min-h-12 items-center text-base hover:text-white",
                    isCurrent(item.path) ? "text-white" : "text-white/70",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn-primary mt-5 w-full" href="/contact">
          {site.ui.talkToUs}
        </a>
      </nav>
    </details>
  </div>
</header>
