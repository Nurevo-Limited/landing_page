---
/**
 * Animated line visual for the hero of each inner page. Lines draw in
 * once on load, then stay still. Decorative only. Every kind uses the
 * same stroke weight and the fixed-coordinate brand gradient.
 */
interface Props {
  kind: "technology" | "solutions" | "about" | "faq" | "company" | "contact" | "news";
}

const { kind } = Astro.props;
const g = "url(#nv-hero)";
const soft = "rgba(169,237,255,0.28)";
// Solutions: four input streams, a model with an attention grid, an explanation.
const inputs = [72, 140, 212, 280];
const grid = Array.from({ length: 36 }, (_, index) => {
  const row = Math.floor(index / 6);
  const col = index % 6;
  const strength = row === col ? 1 : ((row * 7 + col * 3) % 10) / 10;
  return {
    x: 184 + col * 22,
    y: 116 + row * 22,
    o: (0.12 + strength * 0.78).toFixed(2),
    delay: ((row + col) % 6) + 1,
  };
});
---

<div class="relative mx-auto w-full max-w-sm lg:max-w-none" aria-hidden="true">
  <div class="dot-grid absolute inset-0"></div>
  <div class="glow left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 sm:h-80 sm:w-80"></div>
  <svg class="relative h-auto w-full" viewBox="0 0 480 360" fill="none" focusable="false">
    <g stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5">
      {
        kind === "technology" && (
          <>
            <path class="draw delay-1" pathLength="1" d="M20 180c12-26 22-26 34 0s22 26 34 0" stroke={g} />
            <path class="draw delay-2" pathLength="1" d="M88 180C120 180 128 96 168 96h70" stroke={g} />
            <path class="draw delay-2" pathLength="1" d="M88 180C120 180 128 148 168 148h70" stroke={g} />
            <path class="draw delay-2" pathLength="1" d="M88 180C120 180 128 212 168 212h70" stroke={g} />
            <path class="draw delay-2" pathLength="1" d="M88 180C120 180 128 264 168 264h70" stroke={g} />
            <path class="draw delay-3" pathLength="1" d="M238 96C290 96 290 180 318 180M238 148C280 148 290 180 318 180M238 212C280 212 290 180 318 180M238 264C290 264 290 180 318 180" stroke={g} />
            <circle class="fade delay-4" cx="318" cy="180" r="6" stroke="#A9EDFF" fill="#0A1628" />
            <rect class="draw delay-5" pathLength="1" x="342" y="122" width="118" height="116" rx="16" stroke={g} />
            <g class="fade delay-6" stroke="none">
              {[0, 1, 2, 3].map((i) => (
                <>
                  <rect x="358" y={142 + i * 22} width="86" height="7" rx="3.5" fill="rgba(255,255,255,0.08)" />
                  <rect x="358" y={142 + i * 22} width={[74, 58, 42, 28][i]} height="7" rx="3.5" fill={g} />
                </>
              ))}
            </g>
          </>
        )
      }
      {
        kind === "solutions" && (
          <>
            {inputs.map((y, i) => (
              <>
                <circle class:list={["fade", `delay-${i + 1}`]} cx="46" cy={y} r="20" stroke={g} fill="#0A1628" />
                <path class:list={["draw", `delay-${i + 1}`]} pathLength="1" d={`M66 ${y}C110 ${y} 120 180 168 180`} stroke={g} />
              </>
            ))}
            <g class="fade delay-1" stroke="#A9EDFF" stroke-width="2">
              <path d="M35 72c3-6 4.5-6 7.5 0s4.5 6 7.5 0 4.5-6 7.5 0" />
              <path d="M37 136h18M37 144h12" />
              <path d="M41 207h0M51 207h0M40 217c4 3 8 3 12 0" stroke-linecap="round" stroke-width="2.5" />
              <path d="M38 274h16v12H38z" />
            </g>
            <rect class="draw delay-2" pathLength="1" x="168" y="76" width="160" height="208" rx="22" stroke={g} fill="#0E1D35" />
            <g stroke="none">
              {grid.map((cell) => (
                <rect
                  class:list={["fade", `delay-${cell.delay}`]}
                  x={cell.x}
                  y={cell.y}
                  width="18"
                  height="18"
                  rx="4"
                  fill="#7398FF"
                  fill-opacity={cell.o}
                />
              ))}
            </g>
            <path class="draw delay-5" pathLength="1" d="M328 180h28" stroke="#A9EDFF" />
            <rect class="draw delay-5" pathLength="1" x="356" y="118" width="104" height="124" rx="16" stroke={g} />
            <g class="fade delay-6" stroke="none">
              {[0, 1, 2, 3].map((i) => (
                <>
                  <rect x="372" y={140 + i * 24} width="72" height="7" rx="3.5" fill="rgba(255,255,255,0.08)" />
                  <rect x="372" y={140 + i * 24} width={[64, 48, 34, 22][i]} height="7" rx="3.5" fill="url(#nv-hero)" />
                </>
              ))}
            </g>
          </>
        )
      }
      {
        kind === "about" && (
          <>
            <path d="M40 300H440" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
            <path class="draw delay-1" pathLength="1" d="M40 300C120 296 150 250 200 226S300 160 340 120 410 66 440 60" stroke={g} stroke-width="3" />
            {[
              { x: 110, y: 284 },
              { x: 200, y: 226 },
              { x: 300, y: 158 },
            ].map((p, i) => (
              <>
                <path class:list={["draw", `delay-${i + 2}`]} pathLength="1" d={`M${p.x} ${p.y + 14}V300`} stroke={soft} stroke-width="1.5" />
                <circle class:list={["fade", `delay-${i + 2}`]} cx={p.x} cy={p.y} r="8" stroke="#A9EDFF" fill="#0A1628" />
              </>
            ))}
            <circle class="fade delay-5" cx="440" cy="60" r="34" fill="url(#nv-node)" stroke="none" />
            <circle class="fade delay-5" cx="440" cy="60" r="9" fill="#A9EDFF" stroke="none" />
          </>
        )
      }
      {
        kind === "faq" && (
          <>
            <path class="draw delay-1" pathLength="1" d="M60 70h220a20 20 0 0 1 20 20v70a20 20 0 0 1-20 20H130l-34 28v-28H60a20 20 0 0 1-20-20V90a20 20 0 0 1 20-20z" stroke={g} />
            <path class="draw delay-2" pathLength="1" d="M72 126c8-18 14-18 22 0s14 18 22 0 12-30 20 0 12 22 20 0 10-12 18 0 10 8 16 0" stroke="#A9EDFF" />
            <path class="draw delay-3" pathLength="1" d="M200 196h220a20 20 0 0 1 20 20v60a20 20 0 0 1-20 20h-36v28l-34-28H200a20 20 0 0 1-20-20v-60a20 20 0 0 1 20-20z" stroke={g} />
            <g class="fade delay-5" stroke="none">
              <rect x="208" y="224" width="170" height="9" rx="4.5" fill="url(#nv-hero)" />
              <rect x="208" y="246" width="120" height="9" rx="4.5" fill="rgba(169,237,255,0.35)" />
              <rect x="208" y="268" width="146" height="9" rx="4.5" fill="rgba(169,237,255,0.2)" />
            </g>
          </>
        )
      }
      {
        kind === "company" && (
          <>
            <rect class="draw delay-1" pathLength="1" x="120" y="96" width="220" height="200" rx="18" stroke={soft} />
            <rect class="draw delay-2" pathLength="1" x="100" y="76" width="220" height="200" rx="18" stroke={g} fill="#0A1628" />
            <path class="draw delay-3" pathLength="1" d="M128 132c10-18 16-18 26 0s16 18 26 0" stroke="#A9EDFF" />
            <g class="fade delay-4" stroke="none">
              <rect x="128" y="168" width="150" height="9" rx="4.5" fill="url(#nv-hero)" />
              <rect x="128" y="192" width="110" height="9" rx="4.5" fill="rgba(169,237,255,0.3)" />
              <rect x="128" y="216" width="132" height="9" rx="4.5" fill="rgba(169,237,255,0.2)" />
            </g>
            <g class="fade delay-5">
              {["#0A1628", "#2F5BD8", "#7398FF", "#A9EDFF"].map((fill, i) => (
                <circle cx={372 + (i % 2) * 44} cy={130 + Math.floor(i / 2) * 44} r="16" fill={fill} stroke="rgba(255,255,255,0.25)" stroke-width="1.5" />
              ))}
            </g>
          </>
        )
      }
      {
        kind === "contact" && (
          <>
            <rect class="draw delay-1" pathLength="1" x="60" y="110" width="200" height="140" rx="18" stroke={g} />
            <path class="draw delay-2" pathLength="1" d="M66 120l94 72 94-72" stroke={g} />
            <path class="draw delay-3" pathLength="1" d="M260 180c26 0 34-36 58-36s32 72 56 72 30-36 50-36" stroke="#A9EDFF" />
            <circle class="fade delay-5" cx="430" cy="180" r="30" fill="url(#nv-node)" stroke="none" />
            <circle class="fade delay-5" cx="430" cy="180" r="8" fill="#A9EDFF" stroke="none" />
          </>
        )
      }
      {
        kind === "news" && (
          <>
            {[60, 100, 140].map((r, i) => (
              <path
                class:list={["draw", `delay-${i + 1}`]}
                pathLength="1"
                d={`M${180 - r * 0.7} ${180 - r * 0.7}A${r} ${r} 0 0 0 ${180 - r * 0.7} ${180 + r * 0.7}M${180 + r * 0.7} ${180 - r * 0.7}A${r} ${r} 0 0 1 ${180 + r * 0.7} ${180 + r * 0.7}`}
                stroke={g}
                opacity={1 - i * 0.25}
              />
            ))}
            <circle class="fade delay-4" cx="180" cy="180" r="30" fill="url(#nv-node)" stroke="none" />
            <circle class="fade delay-4" cx="180" cy="180" r="8" fill="#A9EDFF" stroke="none" />
            <g class="fade delay-5" stroke="none">
              <rect x="350" y="130" width="100" height="9" rx="4.5" fill="url(#nv-hero)" />
              <rect x="350" y="154" width="74" height="9" rx="4.5" fill="rgba(169,237,255,0.3)" />
              <rect x="350" y="200" width="100" height="9" rx="4.5" fill="url(#nv-hero)" />
              <rect x="350" y="224" width="60" height="9" rx="4.5" fill="rgba(169,237,255,0.3)" />
            </g>
          </>
        )
      }
    </g>
  </svg>
</div>
