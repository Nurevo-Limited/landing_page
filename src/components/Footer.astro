---
import { Image } from "astro:assets";
import wordmark from "../assets/brand/nurevo-wordmark-gradient.png";
import { site } from "../content/site";

const groups = site.footerGroups.map((group) => ({
  title: site.ui[group.key],
  links: group.paths
    .map((p) => site.pages.find((page) => page.path === p && page.footer))
    .filter((page) => page !== undefined),
}));
const linkClass =
  "text-sm text-slate-300 transition-colors duration-200 hover:text-white";
---

<footer class="hairline-top relative bg-ink text-white">
  <div class="mx-auto w-full max-w-6xl px-6 pt-20 pb-12">
    <p class="sr-only">{site.ui.externalNote}</p>
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="inline-block">
          <Image
            src={wordmark}
            alt="Nurevo home"
            width={155}
            height={28}
            densities={[1, 2]}
            format="webp"
            class="h-7 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-6 max-w-sm text-sm leading-6 text-slate-300">{site.oneLine}</p>
      </div>

      <nav class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-7" aria-label="Footer">
        {
          groups.map((group) => (
            <div>
              <p class="text-xs font-medium uppercase tracking-[0.16em] text-white/50">{group.title}</p>
              <ul class="mt-4 space-y-3">
                {group.links.map((link) => (
                  <li>
                    <a class={linkClass} href={link!.path}>
                      {link!.label}
                    </a>
                  </li>
                ))}
                {group.title === site.ui.footerCompany && (
                  <li>
                    <a class={linkClass} href={site.linkedin} target="_blank" rel="noopener noreferrer">
                      LinkedIn
                    </a>
                  </li>
                )}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="mt-16 border-t border-white/10 pt-8">
      <p class="max-w-3xl text-sm leading-6 text-slate-400">
        Nurevo Technology Limited is registered in Scotland, company number <a class="text-slate-200 underline decoration-white/30 underline-offset-4 hover:text-white" href={site.companiesHouse} target="_blank" rel="noopener noreferrer">{site.companyNumber}</a>. Registered office: {site.street}, {site.locality}, {site.postalCode}.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">{site.disclaimer}</p>
    </div>
  </div>
</footer>
