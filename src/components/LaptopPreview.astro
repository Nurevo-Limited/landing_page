---
/**
 * Illustrative design concept: a session review on a laptop. Left, the
 * guided video conversation with face tracking and live captions; right,
 * example analytics (signals over time and
 * which signals contributed). No numbers and no result. Always shown with
 * the illustrative caption from site.ts.
 */
const rows = [
  { label: "Speech timing and voice", width: 132 },
  { label: "Language", width: 100 },
  { label: "Facial movement", width: 72 },
  { label: "Background information", width: 46 },
];
const reply1 = [8, 14, 22, 12, 26, 18, 10, 20, 28, 16, 12, 22, 8, 14];
const reply2 = [10, 18, 12, 24, 16, 8, 20, 26, 14, 10];
const text = { "font-family": "Inter, sans-serif" };
---

<div class="relative">
  <div class="glow left-1/2 top-1/2 h-80 w-[36rem] max-w-full -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></div>
  <svg class="relative h-auto w-full" viewBox="0 0 720 450" fill="none" aria-hidden="true" focusable="false">
    <!-- Laptop body -->
    <rect x="62" y="12" width="596" height="384" rx="20" fill="#0E1D35" stroke="#FFFFFF" stroke-opacity="0.16"></rect>
    <rect x="76" y="26" width="568" height="356" rx="10" fill="#0A1628"></rect>
    <path d="M14 404h692l-28 30H42z" fill="#152A4A"></path>
    <path d="M14 404h692" stroke="#FFFFFF" stroke-opacity="0.18"></path>
    <rect x="320" y="404" width="80" height="7" rx="3.5" fill="#0A1628" fill-opacity="0.6"></rect>

    <!-- Window bar -->
    <g fill="#FFFFFF" fill-opacity="0.16">
      <circle cx="96" cy="44" r="4"></circle>
      <circle cx="110" cy="44" r="4"></circle>
      <circle cx="124" cy="44" r="4"></circle>
    </g>
    <text x="146" y="48" fill="#CBD5E1" font-size="12" {...text}>Session review</text>
    <rect x="550" y="33" width="78" height="22" rx="11" stroke="#A9EDFF" stroke-opacity="0.45"></rect>
    <text x="561" y="48" fill="#A9EDFF" font-size="10.5" {...text}>Illustrative</text>
    <path d="M76 64H644" stroke="#FFFFFF" stroke-opacity="0.07"></path>

    <!-- Video conversation -->
    <text x="96" y="88" fill="#94A3B8" font-size="10" letter-spacing="1.2" {...text}>VIDEO CONVERSATION</text>
    <rect x="96" y="98" width="210" height="150" rx="12" fill="#13264A"></rect>
    <rect x="96" y="98" width="210" height="150" rx="12" fill="url(#nv-node)" fill-opacity="0.35"></rect>
    <!-- Abstract participant -->
    <ellipse cx="201" cy="158" rx="25" ry="31" stroke="#CBD5E1" stroke-opacity="0.55" stroke-width="1.5"></ellipse>
    <path d="M148 248c5-30 27-46 53-46s48 16 53 46" stroke="#CBD5E1" stroke-opacity="0.55" stroke-width="1.5"></path>
    <!-- Face tracking -->
    <g class="reveal-draw-group" stroke="#A9EDFF" stroke-width="2" stroke-linecap="round">
      <path class="reveal-draw" pathLength="1" d="M168 128v-8h10"></path>
      <path class="reveal-draw" pathLength="1" d="M224 120h10v8"></path>
      <path class="reveal-draw" pathLength="1" d="M168 188v8h10"></path>
      <path class="reveal-draw" pathLength="1" d="M224 196h10v-8"></path>
    </g>
    <path d="M190 151l11 13 11-13M192 176l9-12 9 12" stroke="#7398FF" stroke-opacity="0.6" stroke-width="1" stroke-dasharray="2 3"></path>
    <g fill="#A9EDFF">
      <circle cx="190" cy="151" r="2.2"></circle>
      <circle cx="212" cy="151" r="2.2"></circle>
      <circle cx="201" cy="164" r="2.2"></circle>
      <circle cx="192" cy="176" r="2.2"></circle>
      <circle cx="210" cy="176" r="2.2"></circle>
    </g>
    <!-- Live chip and self view -->
    <rect x="106" y="108" width="46" height="18" rx="9" fill="#0A1628" fill-opacity="0.75"></rect>
    <circle cx="116" cy="117" r="3" fill="#A9EDFF"></circle>
    <text x="124" y="121" fill="#E2E8F0" font-size="9.5" {...text}>Live</text>
    <rect x="248" y="200" width="48" height="38" rx="6" fill="#0A1628" stroke="#FFFFFF" stroke-opacity="0.2"></rect>
    <circle cx="272" cy="214" r="6" stroke="#94A3B8" stroke-width="1.2"></circle>
    <path d="M262 236c2-7 6-10 10-10s8 3 10 10" stroke="#94A3B8" stroke-width="1.2"></path>
    <!-- Live caption -->
    <rect x="96" y="256" width="210" height="32" rx="10" fill="#152A4A"></rect>
    <text x="110" y="276" fill="#E2E8F0" font-size="11.5" {...text}>Tell me about your morning.</text>
    <!-- Speech -->
    {reply1.concat(reply2).map((h, i) => <rect x={98 + i * 8.6} y={312 - h / 3} width="3.6" height={(h * 2) / 3} rx="1.8" fill="url(#nv-grad-v)" />)}
    <!-- Call controls -->
    <circle cx="160" cy="352" r="14" fill="#152A4A"></circle>
    <rect x="152" y="346" width="11" height="12" rx="2.5" stroke="#E2E8F0" stroke-width="1.4"></rect>
    <path d="M163 350l5-3v10l-5-3" stroke="#E2E8F0" stroke-width="1.4" stroke-linejoin="round"></path>
    <circle cx="196" cy="352" r="14" fill="#152A4A"></circle>
    <text x="188" y="356" fill="#E2E8F0" font-size="10" font-weight="600" {...text}>CC</text>
    <rect x="220" y="338" width="44" height="28" rx="14" fill="#F87171" fill-opacity="0.9"></rect>
    <path d="M232 354c6-5 14-5 20 0" stroke="#0A1628" stroke-width="2" stroke-linecap="round"></path>

    <path d="M326 76V366" stroke="#FFFFFF" stroke-opacity="0.07"></path>

    <!-- Analytics: signals over time -->
    <text x="348" y="88" fill="#94A3B8" font-size="10" letter-spacing="1.2" {...text}>SIGNALS OVER TIME</text>
    <g stroke="#FFFFFF" stroke-opacity="0.06">
      <path d="M348 112H624M348 142H624M348 172H624M348 202H624"></path>
    </g>
    <path
      class="reveal-draw"
      pathLength="1"
      d="M348 170C370 150 384 120 406 128S440 176 466 160 500 110 526 118 566 160 590 146 614 124 624 128"
      stroke="url(#nv-grad)"
      stroke-width="2.5"
      stroke-linecap="round"
    ></path>
    <path
      class="reveal-draw"
      pathLength="1"
      d="M348 190C376 186 392 168 420 174S460 196 488 184 528 150 556 160 600 190 624 178"
      stroke="#A9EDFF"
      stroke-opacity="0.55"
      stroke-width="2"
      stroke-linecap="round"
    ></path>

    <!-- Analytics: contributing signals -->
    <text x="348" y="238" fill="#94A3B8" font-size="10" letter-spacing="1.2" {...text}>CONTRIBUTING SIGNALS</text>
    {
      rows.map((row, index) => (
        <g>
          <text x="348" y={264 + index * 26} fill="#CBD5E1" font-size="11" {...text}>
            {row.label}
          </text>
          <rect x="484" y={256 + index * 26} width="140" height="7" rx="3.5" fill="#FFFFFF" fill-opacity="0.07" />
          <rect class="preview-grow" x="484" y={256 + index * 26} width={row.width} height="7" rx="3.5" fill="url(#nv-grad)" />
        </g>
      ))
    }
    <circle cx="354" cy="364" r="6" stroke="#A9EDFF" stroke-width="1.5"></circle>
    <text x="368" y="368" fill="#E2E8F0" font-size="11" {...text}>Ready for clinician review</text>
  </svg>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .preview-grow {
        transform-box: fill-box;
        transform-origin: left center;
        animation: preview-grow linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
    }
  }

  @keyframes preview-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
