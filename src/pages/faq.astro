---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import Button from "../components/ui/Button.astro";
import { pageByPath, site } from "../content/site";
import { pageGraph } from "../lib/jsonld";

const page = pageByPath("/faq");
const slug = (value: string) => value.toLowerCase().replace(/[^a-z]+/g, "-").replace(/^-|-$/g, "");
const groups = [...new Set(site.faq.map((item) => item.group))].map((group) => ({
  id: slug(group),
  name: group,
  items: site.faq.filter((item) => item.group === group),
}));
---

<Base title={page.title} description={page.description} path={page.path} jsonLd={pageGraph(page)}>
  <PageHero page={page} intro={page.description} visual="faq" />

  <div class="mx-auto grid w-full max-w-6xl gap-12 px-6 py-16 sm:py-24 lg:grid-cols-12">
    <nav class="lg:col-span-3" aria-label="Question groups">
      <div class="lg:sticky lg:top-24">
        <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{site.ui.onThisPage}</p>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-line text-sm lg:flex-col lg:gap-y-2.5 lg:border-l lg:pl-4">
          {
            groups.map((group) => (
              <li>
                <a class="link-quiet text-body hover:text-ink" href={`#${group.id}`}>
                  {group.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="min-w-0 lg:col-span-9">
      {
        groups.map((group, index) => (
          <section class:list={["scroll-mt-24", index > 0 && "mt-20"]} id={group.id} aria-labelledby={`${group.id}-heading`}>
            <h2 id={`${group.id}-heading`} class="font-display text-3xl text-ink sm:text-4xl">
              {group.name}
            </h2>
            <div class="mt-8 divide-y divide-line border-y border-line">
              {group.items.map((item) => (
                <article class="py-8">
                  <h3 id={item.id} class="scroll-mt-24 text-xl font-medium text-ink">
                    <a class="link-quiet text-ink hover:text-link" href={`#${item.id}`}>
                      {item.question}
                    </a>
                  </h3>
                  <p class="mt-3 max-w-3xl text-lg leading-8">{item.answer}</p>
                </article>
              ))}
            </div>
          </section>
        ))
      }

      <div class="mt-20 flex flex-wrap items-center justify-between gap-6 rounded-3xl bg-mist p-8">
        <p class="text-lg text-ink">
          <a href="/company">{site.company.factsLabel}</a>
        </p>
        <Button href="/contact">{site.ui.talkToUs}</Button>
      </div>
      <p class="mt-10 text-sm text-muted">
        {site.ui.lastUpdated} <time datetime={site.updatedIso}>{site.updated}</time>
      </p>
    </div>
  </div>
</Base>
