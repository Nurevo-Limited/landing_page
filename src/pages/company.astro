---
import Base from "../layouts/Base.astro";
import FactsTable from "../components/FactsTable.astro";
import CopyButton from "../components/CopyButton.astro";
import PageHero from "../components/ui/PageHero.astro";
import { pageByPath, site } from "../content/site";
import { pageGraph } from "../lib/jsonld";

const page = pageByPath("/company");
const c = site.company;
const descriptions = [
  { id: "desc-one-line", label: c.oneLineLabel, text: site.oneLine },
  { id: "desc-short", label: c.shortLabel, text: site.shortDescription },
  { id: "desc-long", label: c.longLabel, text: site.longDescription },
];
const toc = [
  { id: "facts", label: "Company facts" },
  { id: "descriptions", label: c.descriptionsTitle },
  { id: "regulatory", label: c.regulatoryTitle },
  { id: "misconceptions", label: c.misconceptionsTitle },
  { id: "colours", label: c.coloursTitle },
  { id: "logos", label: c.pressTitle },
  { id: "media", label: c.mediaTitle },
];
const darkLogo = (file: string) =>
  file.includes("white") || file.includes("on-dark") || file.includes("gradient") || file.includes("favicon");
const h2 = "font-display scroll-mt-24 text-3xl text-ink sm:text-4xl";
---

<Base title={page.title} description={page.description} path={page.path} jsonLd={pageGraph(page)}>
  <PageHero page={page} intro={site.identity} visual="company" />

  <div class="mx-auto grid w-full max-w-6xl gap-12 px-6 py-16 sm:py-24 lg:grid-cols-12">
    <nav class="lg:col-span-3" aria-label={site.ui.onThisPage}>
      <div class="lg:sticky lg:top-24">
        <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{site.ui.onThisPage}</p>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-line text-sm lg:flex-col lg:gap-y-2.5 lg:border-l lg:pl-4">
          {toc.map((item) => (
            <li><a class="link-quiet text-body hover:text-ink" href={`#${item.id}`}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="min-w-0 space-y-24 lg:col-span-9">
      <section aria-labelledby="facts">
        <h2 id="facts" class={h2}>Company facts</h2>
        <div class="mt-8">
          <FactsTable />
        </div>
        <p class="mt-6 text-sm">
          <a href="/facts.txt">{c.factsLabel}</a>
        </p>
      </section>

      <section aria-labelledby="descriptions">
        <h2 id="descriptions" class={h2}>{c.descriptionsTitle}</h2>
        <p class="mt-4 max-w-3xl text-muted">{c.canonicalNote}</p>
        <div class="mt-8 space-y-5">
          {
            descriptions.map((item) => (
              <section class="rounded-3xl border border-line p-7" aria-labelledby={`${item.id}-label`}>
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <h3 id={`${item.id}-label`} class="text-sm font-medium uppercase tracking-[0.16em] text-muted">{item.label}</h3>
                  <CopyButton target={`#${item.id}`} />
                </div>
                <p id={item.id} class="mt-4 text-lg leading-8 text-ink">{item.text}</p>
              </section>
            ))
          }
          <section class="rounded-3xl border border-line bg-mist p-7" aria-labelledby="desc-boilerplate-label">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h3 id="desc-boilerplate-label" class="text-sm font-medium uppercase tracking-[0.16em] text-muted">{c.boilerplateLabel}</h3>
              <CopyButton target="#desc-boilerplate" />
            </div>
            <p class="mt-2 text-sm text-muted">{c.boilerplateNote}</p>
            <p id="desc-boilerplate" class="mt-4 text-lg leading-8 text-ink">{site.shortDescription}</p>
          </section>
        </div>
      </section>

      <section class="tone-dark relative overflow-clip rounded-3xl bg-ink p-8 sm:p-10" aria-labelledby="regulatory">
        <div class="glow -right-24 -top-24 h-72 w-72 opacity-60" aria-hidden="true"></div>
        <div class="relative flex flex-wrap items-center justify-between gap-3">
          <h2 id="regulatory" class="font-display scroll-mt-24 text-3xl text-white">{c.regulatoryTitle}</h2>
          <CopyButton target="#regulatory-text" dark />
        </div>
        <p id="regulatory-text" class="relative mt-6 text-lg leading-8 text-slate-200">{c.regulatory}</p>
      </section>

      <section aria-labelledby="misconceptions">
        <h2 id="misconceptions" class={h2}>{c.misconceptionsTitle}</h2>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {c.misconceptions.map((item) => (
            <li class="flex gap-4 py-5 text-lg leading-8">
              <span aria-hidden="true" class="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="colours">
        <h2 id="colours" class={h2}>{c.coloursTitle}</h2>
        <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {
            c.colours.map((colour) => (
              <li class="overflow-clip rounded-2xl border border-line">
                <svg aria-hidden="true" viewBox="0 0 100 60" class="block h-20 w-full" preserveAspectRatio="none">
                  <rect width="100" height="60" fill={colour.value} />
                </svg>
                <div class="p-4">
                  <p class="text-sm font-medium text-ink">{colour.name}</p>
                  <p class="mt-1 text-sm tracking-wide text-muted">{colour.value}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="logos">
        <h2 id="logos" class={h2}>{c.pressTitle}</h2>
        <p class="mt-4 max-w-3xl">{c.pressIntro}</p>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2">
          {
            site.logos.map((logo) => (
              <li class="rounded-3xl border border-line p-3">
                <div class:list={["flex min-h-44 items-center justify-center rounded-2xl p-6", darkLogo(logo.file) ? "bg-ink" : "bg-mist"]}>
                  <img src={`/brand/${logo.file}`} alt={logo.alt} class="max-h-32 w-auto" loading="lazy" decoding="async" />
                </div>
                <div class="flex items-center justify-between gap-3 px-3 pt-4 pb-2">
                  <p class="text-sm font-medium text-ink">{logo.label}</p>
                  <a class="text-sm" href={`/brand/${logo.file}`} download>
                    {site.ui.download}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="media">
        <h2 id="media" class={h2}>{c.mediaTitle}</h2>
        <p class="mt-4 text-lg">
          <a href={`mailto:${site.emails.media}`}>{site.emails.media}</a>
        </p>
        <p class="mt-10 text-sm text-muted">
          {site.ui.lastUpdated} <time datetime={site.updatedIso}>{site.updated}</time>
        </p>
      </section>
    </div>
  </div>
  <script src="/copy.js" defer></script>
</Base>
