---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SvgDefs from "../components/ui/SvgDefs.astro";
import displayFont from "../assets/fonts/newsreader-latin-400-normal.woff2?url";
import { pageSlug, pageUpdated, site } from "../content/site";
import { graphJson } from "../lib/jsonld";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd: Record<string, unknown>[];
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  jsonLd,
  ogType = "website",
  noindex = false,
} = Astro.props;

const page = site.pages.find((item) => item.path === path);
const indexable = page && page.kind !== "notfound";
const slug = page && indexable ? pageSlug(page) : "index";
const canonical = new URL(path, site.url).href;
const ogImage = new URL(`/og/${slug}.png`, site.url).href;
const markdown = indexable ? new URL(`/${slug}.md`, site.url).href : null;
const modified = page ? pageUpdated(page) : site.updatedIso;
const json = graphJson(jsonLd);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex" : "index, follow, max-image-preview:large"} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title={`${title} (markdown)`} />}
    <link rel="alternate" type="text/plain" href={`${site.url}/llms.txt`} title="llms.txt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}. ${site.legalName}.`} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Nurevo" />
    {ogType === "article" && <meta property="article:modified_time" content={modified} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/brand/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/brand/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/brand/favicon-180.png" sizes="180x180" />
    <meta name="theme-color" content="#0A1628" />
    <script type="application/ld+json" set:html={json} />
  </head>
  <body class="bg-white font-sans text-base leading-7 text-body antialiased">
    <SvgDefs />
    <a class="skip-link" href="#main">{site.ui.skip}</a>
    <Header currentPath={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
